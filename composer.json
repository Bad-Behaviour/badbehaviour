{
	"name": "bad-behaviour/bad-behaviour",
	"description": "Bad Behaviour is a modern bot detection and blocking for PHP applications",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-curl": "*",
		"ext-gmp": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"phpstan/phpstan": "^1.10",
		"squizlabs/php_codesniffer": "^3.7",
		"phpunit/php-code-coverage": "^11.0"
	},
	"homepage": "https://github.com/Bad-Behaviour/badbehaviour",
	"keywords": [
		"bot",
		"comment",
		"trackback",
		"referrer",
		"spam",
		"robot",
		"antispam"
	],
	"authors": [{
		"name": "Michael Hampton"
	}],
	"support" : {
		"issues" : "https://github.com/Bad-Behaviour/badbehaviour/issues",
		"discussions" : "https://github.com/Bad-Behaviour/badbehaviour/discussions",
		"wiki" : "https://github.com/Bad-Behaviour/badbehaviour/wiki"
	},
	"autoload": {
		"psr-4": {
			"BadBehaviour\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"BadBehaviour\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:unit": "phpunit --testsuite Unit",
		"test:integration": "phpunit --testsuite Integration",
		"test:coverage": "phpunit --coverage-html build/coverage/html",
		"test:coverage:clover": "phpunit --coverage-clover build/coverage/clover.xml",
		"static-analysis": "phpstan analyse src tests --level=5",
		"cs-check": "phpcs src tests",
		"cs-fix": "phpcbf src tests",
		"diagnose": "php bin/diagnose.php",
		"schema": "php bin/test-config-schema.php"
	},
	"archive": {
		"exclude": [
			"tests/**",
			"extensions/**",
			"docs/**",
			".github/**",
			".gitignore"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
